class Solution {
public: 
    int findFirst(vector<int>& nums, int target){
        int s = 0;
        int e = nums.size()-1;
        int ans = -1;

        while(s<=e){
            int m = (s+e)/2;
            if(nums[m] == target){
                ans = m;
                // ab hum left me dhundege
                e = m-1;
            }else if(nums[m]<target){
                s = m+1;
            }else{
                e = m-1;
            }
        }
        return ans;
    }

    int findSecond(vector<int>& nums, int target){
        int s =0;
        int e = nums.size()-1;
        int ans = -1;

        while(s<=e){
            int m = (s+e)/2;
            if(nums[m] == target){
                ans= m;
                // ab right me dhundenge
                s= m+1;
            }else if(nums[m]<target){
                s = m+1;
            }else{
                e = m-1;
            }
        }
        return ans;
    }
    vector<int> searchRange(vector<int>& nums, int target) {
        return {findFirst(nums , target) , findSecond(nums , target)};
    }
};
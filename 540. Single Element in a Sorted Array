class Solution {
public:
    int singleNonDuplicate(vector<int>& nums) {
        int s = 0;
        int e = nums.size()-1;

        

        while(s<=e){
            int m = (s+e)/2;
            // pehla edge case
            if(nums.size() == 1){
                return nums[0];
            }
            if(s ==e) return nums[m];
            // ab agr middle he ans ho
            if( m > 0 && m < nums.size() - 1 && nums[m] != nums[m-1] && nums[m] != nums[m+1]){
                return nums[m];
            }
            // ab agr left jana h ya right wo dhekte h
            if(m>0 && nums[m] == nums[m-1]){
                if((m-1)%2 == 0){
                    // iska mtlb (even , odd h )
                    s = m+1;
                }else{
                    e = m-1;
                }
            }
            else if(m< nums.size()-1 && nums[m] == nums[m+1]){
                if((m)%2 == 0){
                    // mtlb m he even h 
                    s = m+1;
                }else{
                    e = m-1;
                }
            }else{
                return nums[m];
            }
        }
        return -1;
    }
};
